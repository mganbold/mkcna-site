---
/**
 * Scroll reveals. Mark an element with `data-reveal`, or a container with
 * `data-reveal-group` to reveal its children one after another.
 * Styles live in global.css (Motion) and only apply without reduced-motion.
 */
---

<script is:inline>
  document.documentElement.classList.add('js');
</script>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const groups = document.querySelectorAll<HTMLElement>('[data-reveal-group]');
  const singles = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const targets: HTMLElement[] = [...singles];

  groups.forEach((group) => {
    Array.from(group.children).forEach((child, i) => {
      const el = child as HTMLElement;
      el.style.setProperty('--reveal-delay', `${Math.min(i * 90, 450)}ms`);
      targets.push(el);
    });
  });

  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((el) => el.classList.add('is-revealed'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => io.observe(el));
  }

  // Jumping to an anchor (e.g. #contact) should never land on hidden content.
  const showTarget = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el) el.querySelectorAll('[data-reveal], [data-reveal-group] > *').forEach((n) => n.classList.add('is-revealed'));
  };
  window.addEventListener('hashchange', showTarget);
  showTarget();
</script>
