---
import { Image } from 'astro:assets';
import { affiliates } from '../data/affiliates';

// Full class names so Tailwind can see them.
const spanClass = { 2: 'md:col-span-2', 3: 'md:col-span-3' } as const;
---

<section id="hubs" class="py-24 bg-brand-ivory border-t border-brand-beige">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-14 max-w-2xl">
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-brand-espresso mb-3">Our Affiliate Community</h1>
      <p class="font-light">
        MKCNA convenes and supports players across North America. These independent groups teach and perform in their own regions, each with its own leadership and funding.
      </p>
    </div>
    <div class="grid md:grid-cols-6 gap-6">
      {
        affiliates.map((a) => (
          <div class:list={[spanClass[a.span], 'bg-brand-cream p-7 rounded-2xl border border-brand-beige']}>
            <div class="h-36 mb-5 rounded-xl bg-white border border-brand-beige flex items-center justify-center overflow-hidden">
              <Image src={a.logo} alt={`${a.name} logo`} class="max-h-32 max-w-[80%] w-auto h-auto object-contain" />
            </div>
            <span class="text-xs font-semibold text-brand-amberDark bg-brand-amber/15 px-3 py-1 rounded-full">{a.region}</span>
            <h2 class="text-xl font-bold text-brand-espresso mt-4">{a.name}</h2>
            <p class="text-sm font-medium">{a.location}</p>
            <p class="text-sm mt-3 leading-relaxed font-light">{a.description}</p>
            {a.link && (
              <p class="mt-4 text-sm">
                <a class="underline text-brand-amberDark font-semibold" href={a.link.href} target="_blank" rel="noopener noreferrer">
                  {a.link.label}
                </a>
              </p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
