---
import { Image } from 'astro:assets';
import galaPhoto from '../assets/videos/gala-performers-2026.webp';
import YouTube from './YouTube.astro';
import { videos } from '../data/videos';
---

<section id="videos" class="py-24 bg-brand-cream">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-14" data-reveal>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-brand-espresso mb-4">Experience the Sound of the Morin Khuur</h1>
      <p class="font-light leading-relaxed">Featured performances and festival recordings from our artist network.</p>
    </div>
    <figure class="mb-8 m-0" data-reveal>
      <Image
        src={galaPhoto}
        widths={[640, 1024, 1440, 1800]}
        sizes="(min-width: 1280px) 1232px, calc(100vw - 48px)"
        loading="eager"
        class="w-full h-auto rounded-2xl"
        alt="Performers in traditional Mongolian deels with a morin khuur player and a performer in a tuxedo, on stage after the gala concert of the 4th Morin Khuur Festival in the USA"
      />
      <figcaption class="text-sm text-center mt-3 opacity-80">Performers after the gala concert of the 4th Morin Khuur Festival in the USA, May 10, 2026.</figcaption>
    </figure>
    <div class="grid md:grid-cols-2 gap-8" data-reveal-group>
      {
        videos.map((v) => (
          <div class="bg-brand-ivory p-4 rounded-2xl border border-brand-beige">
            <YouTube id={v.id} title={v.title} class="rounded-xl" />
            <h2 class="font-bold text-brand-espresso mt-4">{v.title}</h2>
            <p class="text-sm">
              {v.description}{' '}
              <a class="underline text-brand-amberDark" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener noreferrer">
                Open on YouTube
              </a>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
