---
import { board, executiveTeam, initials, type Person } from '../data/leadership';

const groups: { people: Person[]; avatar: string }[] = [
  { people: board, avatar: 'bg-brand-espresso text-brand-cream' },
  { people: executiveTeam, avatar: 'bg-brand-amber text-brand-espresso' },
];
---

<section id="leadership" class="py-20 md:py-24 bg-brand-ivory border-t border-brand-beige scroll-mt-20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="text-3xl md:text-5xl md:leading-none font-serif font-bold text-brand-espresso leading-tight mb-5">Board of Directors</h2>
      <p class="text-lg font-light">Meet the people who guide MKCNA.</p>
    </div>
    {
      groups.map((g, i) => (
        <>
          {i === 1 && <h2 class="text-2xl md:text-3xl font-serif font-bold text-brand-espresso text-center mt-14 mb-8">Executive Team</h2>}
          <ul class:list={['grid gap-x-6 gap-y-10 list-none p-0 m-0', i === 0 ? 'grid-cols-2 lg:grid-cols-4' : 'grid-cols-2 mx-auto lg:max-w-[564px]']}>
            {g.people.map((p) => (
              <li class="text-center">
                <div class:list={['mx-auto mb-4 w-24 h-24 rounded-full flex items-center justify-center font-serif text-2xl font-bold', g.avatar]} aria-hidden="true">
                  {initials(p.name)}
                </div>
                <h3 class="font-bold text-brand-espresso">{p.name}</h3>
                <p class="text-sm text-brand-amberDark font-medium mb-2">{p.role}</p>
                {p.bio ? <p class="text-sm">{p.bio}</p> : <p class="text-sm italic opacity-70">Bio coming soon.</p>}
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </div>
</section>
